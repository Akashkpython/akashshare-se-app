# API Configuration - Dynamic (will be detected automatically in Electron apps)
# For development on localhost, this can be set to http://localhost:5002
# For network access, this should be set to http://YOUR_LOCAL_IP:5002
# REACT_APP_API_URL=http://localhost:5002

# Database Configuration - For backend server
# For MongoDB Atlas connection string - REPLACE WITH YOUR ACTUAL CREDENTIALS
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE?retryWrites=true&w=majority

# Server Configuration - For backend server
PORT=5002
HOST=0.0.0.0

# Security
JWT_SECRET=YOUR_JWT_SECRET_HERE_GENERATE_WITH_CRYPTO_RANDOM_BYTES

# File Upload Configuration
FILE_SIZE_LIMIT=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Environment
NODE_ENV=development