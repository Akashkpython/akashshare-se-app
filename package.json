{
  "name": "akash-share",
  "version": "1.0.5",
  "description": "Akash Share - Professional File Sharing Application",
  "main": "electron/main.js",
  "homepage": "./",
  "author": "Akash Share Team",
  "private": true,
  "type": "module",
  "dependencies": {
    "@mongodb-js/saslprep": "^1.1.0",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "axios": "^1.6.2",
    "chai": "^4.3.10",
    "chai-http": "^4.4.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "debug": "^4.3.4",
    "dotenv": "^16.3.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "eslint-config-prettier": "^10.1.8",
    "express": "^4.18.2",
    "express-rate-limit": "^5.5.1",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.4",
    "framer-motion": "^10.16.16",
    "helmet": "^7.1.0",
    "lucide-react": "^0.544.0",
    "mocha": "^10.2.0",
    "mongodb": "^6.19.0",
    "mongoose": "^8.18.1",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "react-scripts": "5.0.1",
    "recharts": "^3.2.0",
    "shortid": "^2.2.17",
    "supertest": "^6.3.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^2.1.4",
    "ws": "^8.18.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.1"
  },
  "scripts": {
    "start": "cross-env PORT=5004 react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "backend": "cd backend && node server.js",
    "backend:dev": "cd backend && nodemon server.js",
    "backend:start": "cd backend && npm start",
    "backend:install": "cd backend && npm install",
    "dev": "node scripts/start-unified.js",
    "dev:full": "node scripts/electron-unified.js",
    "electron": "cross-env NODE_ENV=development electron .",
    "electron:copy": "node scripts/copy-electron.js",
    "electron:build": "npm run build && npm run electron:copy && electron-builder",
    "electron:pack": "npm run build && npm run electron:copy && electron-builder --dir",
    "electron:dist": "npm run build && npm run electron:copy && electron-builder --publish=never",
    "build:win": "npm run build && npm run electron:copy && electron-builder --win --publish=never",
    "build:win:portable": "npm run build && npm run electron:copy && electron-builder --win --dir",
    "build:win:custom": "npm run build && npm run electron:copy && electron-builder --win --config.nsis.perMachine=true --publish=never",
    "build:win:user": "npm run build && npm run electron:copy && electron-builder --win --config.nsis.perMachine=false --publish=never",
    "build:installer": "npm run build:win:custom",
    "setup": "npm run build:win:custom",
    "installer": "npm run build:win:custom",
    "install:all": "npm install && npm run backend:install",
    "start:all": "concurrently \"npm run backend\" \"npm start\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy",
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/src/__mocks__/fileMock.js"
    },
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ]
  },
  "build": {
    "appId": "com.akashshare.app",
    "productName": "Akash Share",
    "copyright": "Copyright © 2024 Akash Share Team",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/akashshare/akashshare-releases/releases/download/"
      }
    ],
    "files": [
      "build/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/.cache",
      "!node_modules/electron/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "publisherName": "Akash Share Team",
      "artifactName": "AkashShare-${version}-Setup.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Akash Share",
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "installerHeaderIcon": "build-resources/icon.ico",
      "displayLanguageSelector": false,
      "language": "1033",
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE",
      "runAfterFinish": true,
      "menuCategory": "Akash Share",
      "include": "build-resources/installer.nsh"
    },
    "compression": "maximum",
    "removePackageScripts": true,
    "extraFiles": [
      {
        "from": "build/preload.js",
        "to": "preload.js"
      }
    ]
  }
}
