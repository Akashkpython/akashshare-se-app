# Production Environment Example (do NOT commit real secrets)
# Copy this file to .env.production and fill in real values locally

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=APPNAME

# JWT Secret
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET

# Server
PORT=5002
HOST=0.0.0.0
NODE_ENV=production

# File Upload
FILE_SIZE_LIMIT=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,text/plain,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket
WS_CONNECTION_LIMIT=10
WS_RATE_LIMIT_WINDOW=60000
WS_RATE_LIMIT_MAX=5
