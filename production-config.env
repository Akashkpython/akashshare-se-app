# Production Environment Configuration for Render Deployment
# IP Address: 44.229.227.142

# Environment
NODE_ENV=production
HOST=0.0.0.0
PORT=5002

# MongoDB Atlas Configuration
# SECURITY WARNING: Set these values via secure environment variables in production
MONGO_URI=${MONGO_URI}

# Security Configuration
# SECURITY WARNING: Generate a secure random JWT secret and set via environment variables
JWT_SECRET=${JWT_SECRET}

# File Upload Configuration
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,text/plain,application/pdf
FILE_SIZE_LIMIT=10485760

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# WebSocket Configuration
WS_CONNECTION_LIMIT=10
WS_RATE_LIMIT_MAX=5
WS_RATE_LIMIT_WINDOW=60000

# Production Security Settings
CORS_ORIGIN=https://akashshare-se.onrender.com
TRUST_PROXY=true

# Performance Settings
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
CACHE_TTL=3600

# Logging Configuration
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
